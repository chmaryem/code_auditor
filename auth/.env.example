# ─────────────────────────────────────────────────────────────────────────────
# Authentication module — add these to your project root .env
# (passwordless email-OTP login + JWT). Reuses the existing REDIS_URL / MCP Redis.
# ─────────────────────────────────────────────────────────────────────────────

# Master switch. Set to false to disable enforcement during local dev.
AUTH_REQUIRED=true

# REQUIRED in production: a long random string. If empty, an ephemeral secret is
# generated at startup and ALL sessions are invalidated on every restart.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=

# Token lifetimes
AUTH_ACCESS_TTL_MIN=60
AUTH_REFRESH_TTL_DAYS=14
AUTH_PAIRING_TTL_SEC=90

# One-time code (OTP) policy
AUTH_OTP_LENGTH=6
AUTH_OTP_TTL_SEC=600
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SEC=60
AUTH_OTP_RATE_PER_HOUR=5

# Work-email restriction. Comma-separated domains; leave EMPTY to allow any email.
#   e.g. AUTH_ALLOWED_EMAIL_DOMAINS=esprit.tn,company.com
AUTH_ALLOWED_EMAIL_DOMAINS=

# ── Gmail SMTP (App Password — NOT your normal Gmail password) ────────────────
# Create one at: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Code Auditor AI

# Reused by the MCP Redis transport (already in your .env, shown for reference)
# REDIS_URL=redis://localhost:6379/0
